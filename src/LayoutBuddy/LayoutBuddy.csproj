<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- For System.Windows.Automation (UI Automation client) -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>LanguageAutocorrect</AssemblyName>
    <RootNamespace>LayoutBuddy</RootNamespace>
    <Version>3.3.1</Version>
    <Product>Language Autocorrect</Product>
    <Company>Eithan Avraham</Company>
    <Authors>Eithan Avraham</Authors>
    <Copyright>© Eithan Avraham</Copyright>
    <AssemblyTitle>Language Autocorrect</AssemblyTitle>
    <ApplicationIcon>Assets\LayoutBuddy.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\app.html" LogicalName="LayoutBuddy.UI.app.html" />
    <EmbeddedResource Include="UI\setup.html" LogicalName="LayoutBuddy.UI.setup.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LayoutBuddy.Engine\LayoutBuddy.Engine.csproj" />
  </ItemGroup>

</Project>
